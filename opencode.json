{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bosch-jira": {
      "type": "local",
      "command": ["bosch-jira-mcp"],
      "environment": {
        "JIRA_BASE_URL": "https://rb-tracker.bosch.com/tracker01",
        "JIRA_TOKEN": "{env:TR_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "bosch-jira_*": "ask"
  }
}
